# ─── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32-char-secret
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, zero-config)
DATABASE_URL=sqlite:///./storage/alibirds.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/alibirds

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=invoices@yourstudio.nl
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME=Your Studio Name
SMTP_FROM_EMAIL=invoices@yourstudio.nl
SMTP_STARTTLS=true

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PATH=./storage
PDF_OUTPUT_DIR=./storage/invoices
RECEIPT_UPLOAD_DIR=./storage/receipts
MT940_UPLOAD_DIR=./storage/mt940

# ─── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Europe/Amsterdam
RECURRING_CRON_HOUR=8
RECURRING_CRON_MINUTE=0
